# Install inside nginx's http context (for example conf.d/club.conf).
# Replace club.example, certificate paths and /srv/beavers/dist-prerender before enabling.
# Uses backend compose.production.yaml on the same host. API and frontend share an origin.
limit_req_zone $binary_remote_addr zone=club_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=club_api:10m rate=30r/s;
map $uri $club_robots {
    default "";
    ~^/admin(?:/|$) "noindex, nofollow";
    /spa.html "noindex, nofollow";
}

server {
    listen 80;
    server_name club.example;
    return 301 https://club.example$request_uri;
}

server {
    listen 443 ssl;
    server_name club.example;
    ssl_certificate /etc/letsencrypt/live/club.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/club.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # npm run build:prerender produces public HTML plus a separate private SPA shell.
    # Plain SPA deployments can use dist with the same fallback below.
    root /srv/beavers/dist-prerender;
    index index.html;
    server_tokens off;
    client_max_body_size 9m;
    limit_req_status 429;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag $club_robots always;
    # Inline styles support Vue's dynamic presentation. Scripts remain same-origin.
    # External HTTPS images are ASB emblems; only Yandex may provide map frames.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src https://yandex.ru; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;

    location = /api/v1/auth/login {
        limit_req zone=club_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /api/ {
        limit_req zone=club_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /media/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Preserve API Cache-Control/Vary: private previews must never be cached here.
        proxy_cache off;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location = /index.html {
        expires -1;
    }

    location = /spa.html {
        expires -1;
    }

    location = /admin {
        expires -1;
        try_files /admin/index.html /spa.html /index.html =404;
    }

    location = / {
        expires -1;
        try_files /index.html =404;
    }

    location / {
        expires -1;
        # A missing profile/unknown route must receive the noindex SPA shell,
        # never a misleading home-page snapshot. Client routing then resolves it.
        try_files $uri/index.html $uri /spa.html /index.html;
    }
}
