{
  "name": "predatory-beavers-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "build:prerender": "npm run type-check && node scripts/prerender.mjs",
    "refresh:prerender": "node scripts/prerender-refresh.mjs",
    "test:prerender": "node --test scripts/prerender.test.mjs scripts/prerender-refresh.test.mjs",
    "verify:prerender": "node scripts/verify-prerender.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test public.spec.ts matches.spec.ts navigation.spec.ts standings.spec.ts playoff-bracket.spec.ts match-dates.spec.ts match-outcomes.spec.ts archive.spec.ts landing.spec.ts honours-roster.spec.ts tournament-history.spec.ts calendar-server.spec.ts profile-metadata.spec.ts",
    "test:e2e:admin": "playwright test admin.spec.ts admin-workflows.spec.ts admin-editor-races.spec.ts",
    "test:e2e:report": "playwright show-report .data/playwright-report",
    "type-check": "vue-tsc --build",
    "api:generate": "node scripts/generate_api.mjs",
    "lint": "eslint . --fix --cache",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json,md}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json,md}\" \"*.{ts,json,md}\""
  },
  "dependencies": {
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.6.2",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.7.4",
    "sass": "^1.97.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2"
  }
}
